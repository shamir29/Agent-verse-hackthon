{
  "name": "pollution-ai-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "backend": "npm run start --workspace=backend",
    "backend:dev": "npm run dev --workspace=backend",
    "frontend": "npm run dev --workspace=frontend",
    "dev": "npx concurrently --kill-others \"npm run backend:dev\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
